---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" noindex>
  <div style="text-align:center;padding:80px 0">
    <div class="kicker">Erro 404</div>
    <h1 class="page-title" style="margin-top:8px">Game over: essa página não existe</h1>
    <p class="page-sub">Ela pode ter mudado de endereço ou saído do ar.</p>
    <a class="btn btn-primary" href="/">Voltar ao início</a>
  </div>
</Base>
