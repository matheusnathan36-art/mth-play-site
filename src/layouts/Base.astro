---
import '../styles/global.css';
import { SITE, MENU_CATEGORIES } from '../data/site';
import { socialLinks as social } from '../lib/social';
import { getPosts, topTags, slugify } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description = SITE.description, image, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Sem capa, usa a arte padrão com o logo ao compartilhar no WhatsApp/redes.
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
const path = Astro.url.pathname;
// Aceita só o código ou a tag inteira colada do Google.
const gv = (SITE.googleVerification || '').trim();
const googleCode = gv.match(/content=["']([^"']+)["']/)?.[1] ?? gv.replace(/[<>"]/g, '');
const tags = topTags(await getPosts(), 8);
const platforms = MENU_CATEGORIES;
const sections = [
  { href: '/noticias/', label: 'Notícias' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/guias/', label: 'Guias' },
  { href: '/videos/', label: 'Vídeos' },
  { href: '/lancamentos/', label: 'Lançamentos' },
  { href: '/jogos/', label: 'Jogos' },
];
const allSections = [...sections, { href: '/listas/', label: 'Listas' }];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/logo-square.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo-square.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {googleCode && <meta name="google-site-verification" content={googleCode} />}
    {
      SITE.adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient.startsWith('ca-') ? SITE.adsenseClient : 'ca-' + SITE.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    <meta name="theme-color" content="#0b0c14" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <style set:html={`:root{--brand-1:${SITE.colors.primary};--brand-2:${SITE.colors.secondary}}`}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <div class="topbar">
      <div class="container topbar-row">
        <div class="trending">
          <span class="trending-label">Em alta</span>
          {tags.map((t) => <a href={`/tag/${slugify(t)}/`}>{t}</a>)}
        </div>
        <div class="social">
          {social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d={s.d} /></svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-row">
        <details class="mobile-menu">
          <summary class="icon-btn" aria-label="Abrir menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </summary>
          <div class="drawer">
            <form action="/busca/" class="search-form"><input name="q" type="search" placeholder="Buscar no MTH Play" aria-label="Buscar" /></form>
            <p class="drawer-title">Seções</p>
            {allSections.map((s) => <a href={s.href}>{s.label}</a>)}
            <p class="drawer-title">Plataformas</p>
            {platforms.map((c) => <a href={`/categoria/${c.slug}/`}><span class="dot" style={`--cat:${c.color}`}></span>{c.name}</a>)}
          </div>
        </details>

        <a href="/" class="logo" aria-label={`${SITE.name}, início`}>
          <img src={SITE.logo} alt={SITE.name} />
        </a>

        <nav class="nav" aria-label="Seções">
          {sections.map((s) => <a href={s.href} aria-current={path.startsWith(s.href) ? 'page' : undefined}>{s.label}</a>)}
          <div class="dropdown">
            <button class="dropdown-btn" aria-haspopup="true">Plataformas <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg></button>
            <div class="dropdown-menu">
              {platforms.map((c) => <a href={`/categoria/${c.slug}/`}><span class="dot" style={`--cat:${c.color}`}></span>{c.name}</a>)}
            </div>
          </div>
        </nav>

        <div class="header-actions">
          <form action="/busca/" class="search-form header-search" role="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input name="q" type="search" placeholder="Buscar jogos, notícias..." aria-label="Buscar" />
          </form>
          <a class="icon-btn search-mobile" href="/busca/" aria-label="Buscar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          </a>
          <button class="icon-btn" id="theme-toggle" aria-label="Alternar tema claro/escuro">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="conteudo" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo logo-footer"><img src={SITE.logo} alt={SITE.name} loading="lazy" /></a>
          <p>{SITE.description}</p>
          <div class="social">
            {social.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <svg viewBox="0 0 24 24" fill="currentColor"><path d={s.d} /></svg>
              </a>
            ))}
          </div>
        </div>
        <div>
          <h3>Seções</h3>
          {allSections.map((s) => <a href={s.href}>{s.label}</a>)}
        </div>
        <div>
          <h3>Plataformas</h3>
          {platforms.map((c) => <a href={`/categoria/${c.slug}/`}>{c.name}</a>)}
        </div>
        <div>
          <h3>MTH Play</h3>
          <a href="/sobre/">Sobre</a>
          <a href="/equipe/">Equipe</a>
          <a href="/contato/">Contato</a>
          <a href="/privacidade/">Privacidade</a>
          <a href="/termos/">Termos de uso</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {SITE.name}. Todos os direitos reservados.</span>
        {SITE.footerNote && <span>{SITE.footerNote}</span>}
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
