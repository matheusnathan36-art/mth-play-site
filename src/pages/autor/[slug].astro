---
import Base from '../../layouts/Base.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getAuthors, getPosts, postsByAuthor } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getAuthors().map((autor) => ({ params: { slug: autor.id }, props: { autor, posts: postsByAuthor(posts, autor) } }));
}
const { autor, posts } = Astro.props;
---

<Base title={autor.data.name} description={autor.body?.trim().slice(0, 160) || `Publicações de ${autor.data.name} no MTH Play.`}>
  <header class="page-head">
    <AuthorCard autor={autor} big />
  </header>
  <div class="layout-2">
    <section>
      <SectionHead title={`Publicações de ${autor.data.name}`} />
      {posts.length === 0 && <p class="page-sub">Nenhuma publicação ainda.</p>}
      <div class="rows">{posts.map((p) => <PostCard post={p} variant="row" />)}</div>
    </section>
    <Sidebar />
  </div>
</Base>
