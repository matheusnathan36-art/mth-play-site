---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugify(t), t)));
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name}>
  <header class="page-head">
    <span class="pill pill-type">Assunto</span>
    <h1 class="page-title">{name}</h1>
    <p class="page-sub">{posts.length} publicaç{posts.length === 1 ? 'ão' : 'ões'} sobre {name}.</p>
  </header>
  <div class="layout-2">
    <section class="rows">
      {posts.map((p) => <PostCard post={p} variant="row" />)}
    </section>
    <Sidebar />
  </div>
</Base>
